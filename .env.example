# DeepSeek API configuration
# Copy this file to `.env.local` and fill in your real key.
# `.env.local` is gitignored, so the key never gets committed.
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-chat

# Google OAuth (Auth.js / next-auth)
# ---------------------------------------------------------------
# 1. Create an OAuth 2.0 Client ID at:
#    https://console.cloud.google.com/apis/credentials
#    (Application type: Web application)
# 2. Add this as an Authorized redirect URI:
#    http://localhost:3000/api/auth/callback/google
#    (in production, replace localhost with your real domain)
# 3. Generate a secret for signing session cookies:
#    npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=your_generated_secret_here
AUTH_GOOGLE_ID=your_google_client_id.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=your_google_client_secret

# PostgreSQL (users + bookings)
# ---------------------------------------------------------------
# Used by the Credentials provider and the user dashboard.
# You can provide a single connection string…
DATABASE_URL=postgres://postgres:your_password@localhost:5432/trekking_nepal
# …or use the standard PG env vars instead (DATABASE_URL wins if set).
# PGHOST=localhost
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=your_password
# PGDATABASE=trekking_nepal
#
# After configuring, create the tables + demo user once:
#   node scripts/init-db.mjs
# Demo login: demo@trekkingnepal.com / demo1234

# Admin panel credentials
# ---------------------------------------------------------------
# Used by the /admin login screen and the /api/admin/* routes.
# Values are exposed to the browser (NEXT_PUBLIC_), so treat as demo
# auth only, not real security. Copy this pair into your gitignored
# .env / .env.local file with your chosen values.
NEXT_PUBLIC_ADMIN_EMAIL=admin@trekkingnepal.com
NEXT_PUBLIC_ADMIN_PASSWORD=admin123

# SEO / Metadata
# ---------------------------------------------------------------
# The public origin used for canonical URLs, sitemap, robots.txt and
# Open Graph/Twitter images. Set this to your real domain in production,
# e.g. https://trekkingnepal.example
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Search Console site verification token (optional).
# Copy it from https://search.google.com/search-console after adding
# your domain — the meta tag content goes here, not the full tag.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your_google_verification_token
